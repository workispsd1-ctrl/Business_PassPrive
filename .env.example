# Launch popup → Google Sheet capture.
# Google Apps Script Web App URL (see components/launch-sheet.gs for setup steps).
# Copy this file to .env.local and paste your deployed /exec URL below.
NEXT_PUBLIC_LAUNCH_SHEET_URL=

# Supabase — must be the same project as passprive-admin, so admin accounts
# created there can sign in on /onboarding.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
